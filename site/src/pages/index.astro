---
import Base from "../layouts/Base.astro";
import Label from "../components/Label.astro";
import bench from "../data/benchmark.json";
import { FAULT_NAME } from "../lib/plain";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const repo = "https://github.com/moaddreem/k8s-healing-agent";
type Summary = { mode: string; split: string; ok: number; total: number; avgSeconds: number | null; unsafe: number; llmCalls: number };
type FaultRow = { fault: string; split: string; expected: string; modes: Record<string, { ok: boolean; outcome: string; seconds: number | null }> };
const done = (bench as { status: string }).status === "done";
const summary: Summary[] = done ? (bench as unknown as { summary: Summary[] }).summary : [];
const faults: FaultRow[] = done ? (bench as unknown as { faults: FaultRow[] }).faults : [];
const modes = ["rules", "llm", "hybrid"];
const modeName: Record<string, string> = { rules: "Rules only", llm: "AI model only", hybrid: "Nabd (rules + AI)" };
const total = (m: string) => {
  const rows = summary.filter((s) => s.mode === m);
  return { ok: rows.reduce((a, r) => a + r.ok, 0), n: rows.reduce((a, r) => a + r.total, 0), unsafe: rows.reduce((a, r) => a + r.unsafe, 0), calls: rows.reduce((a, r) => a + r.llmCalls, 0) };
};
const held = (m: string) => summary.find((s) => s.mode === m && s.split === "heldout");
const hybrid = total("hybrid");

const plain = FAULT_NAME;
const cell = (r?: { ok: boolean; outcome: string }) =>
  !r ? "–" : r.ok ? (r.outcome === "resolved" ? "Fixed" : "Handed to a human") : "Missed";

const glossary = [
  ["Kubernetes", "The system most cloud apps run on. It keeps many copies of an app running across many servers and restarts them when they crash."],
  ["Pod", "One running copy of an app."],
  ["Deployment", "The instruction “keep N copies of this app running, with this version and these settings”."],
  ["Service", "The stable address other apps and users call. It forwards traffic to the pods that carry the right label."],
  ["Rollback", "Going back to the last version that worked."],
  ["ConfigMap and Secret", "Where an app's settings and passwords are kept, outside the app itself."],
  ["Dry-run", "Asking Kubernetes “would this change be accepted?” without making it."],
  ["Held-out test", "Problems kept hidden while building, used only at the end, to prove it handles cases it was not built for."],
];
---
<Base title="Nabd · Safe, automatic recovery for Kubernetes apps" description="Nabd (نبض) is an AI agent that finds out why a Kubernetes app broke and fixes it with a short list of pre-approved actions, asking a human whenever a fix is not safe." page="home">
  <main>
    <section class="hero wrap">
      <div class="pitch">
        <h1>When an app breaks, Nabd finds out why and fixes it safely.</h1>
        <p class="lede">
          Nabd <span class="ar" lang="ar">نبض</span> is an AI agent for Kubernetes, the system most cloud apps run on. It investigates
          like an engineer, fixes only with a short list of pre-approved actions, and asks a human whenever a fix isn't safe.
        </p>
        <div class="ctas">
          <a class="btn" href={`${base}/demo/`}>
            Try it in your browser
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11m-4-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a class="btn ghost" href="#problem">What problem does it solve?</a>
        </div>
      </div>
      <div class="counter">
        <div class="tryline">
          <span>Break something</span>
          <div class="chips" role="group" aria-label="Faults">
            <button class="chip" type="button" data-fault="dev-01-image-typo">Typo in the version</button>
            <button class="chip" type="button" data-fault="dev-09-scaled-to-zero">App switched off</button>
            <button class="chip" type="button" data-fault="dev-06-selector-mismatch">Traffic sent nowhere</button>
            <button class="chip" type="button" data-fault="dev-08-missing-secret">Password deleted</button>
          </div>
        </div>
        <Label id="hero-rx" />
        <p class="note">Nabd's real rules, running on a simulated copy of our test system. Each line is a step it takes.</p>
      </div>
    </section>

    <section id="problem" class="problem wrap" aria-labelledby="problem-h">
      <h2 id="problem-h">Apps rarely break in dramatic ways. They break in small, boring ones.</h2>
      <ol class="story">
        <li>
          <h3>A small change slips in</h3>
          <p>A typo in a version number. A wrong port. A setting renamed. A password deleted by mistake.</p>
        </li>
        <li>
          <h3>The app goes down</h3>
          <p>Users see errors. Kubernetes restarts it again and again, but restarting can't fix a wrong setting.</p>
        </li>
        <li>
          <h3>Someone has to dig</h3>
          <p>An engineer gets woken up, reads logs and events, finds the one line that's wrong, and fixes it carefully, while users wait.</p>
        </li>
      </ol>
      <div class="why">
        <h3>So why not let an AI fix it?</h3>
        <p>
          Because an AI that can run any command can also delete data, expose passwords, or make things worse with a confident guess.
          Finding the fix isn't the hard part. <strong>Trusting the fixer is.</strong>
        </p>
      </div>
    </section>

    <section class="answer wrap" aria-labelledby="answer-h">
      <div class="head">
        <h2 id="answer-h">Nabd works like a pharmacist with a short list.</h2>
        <p>A pharmacist can only hand out what's on the approved list, and some medicines need a doctor's signature. Nabd is built the same way.</p>
      </div>
      <div class="rules3">
        <div>
          <h3><span class="dot ok"></span>Does on its own</h3>
          <ul>
            <li>Go back to the last version that worked</li>
            <li>Bring back the right number of copies</li>
            <li>Restart the app to pick up a corrected setting</li>
          </ul>
        </div>
        <div>
          <h3><span class="dot warn"></span>Asks you first</h3>
          <ul>
            <li>Change where traffic is sent</li>
            <li>Fix the name of a setting</li>
          </ul>
        </div>
        <div>
          <h3><span class="dot no"></span>Never does</h3>
          <ul>
            <li>Delete anything</li>
            <li>Read, guess or invent passwords</li>
            <li>Touch anything outside its own area</li>
            <li>Retry the same fix again and again</li>
          </ul>
        </div>
      </div>
      <p class="after">
        If something isn't on the list, Nabd stops and hands it to a human with everything it found. Every change is tested with a
        dry-run first, checked afterwards, and undone automatically if it didn't help.
      </p>
    </section>

    <section class="incident wrap" aria-labelledby="incident-h">
      <div class="head">
        <h2 id="incident-h">One real incident, start to finish</h2>
        <p>From a live run on our test cluster. Nabd writes a report like this after every incident.</p>
      </div>
      <ol class="case">
        <li><span class="t">0 s</span><div><h3>The website stops answering</h3><p>The health check gets “connection refused” from the web app.</p></div></li>
        <li><span class="t">4 s</span><div><h3>Nabd finds the cause</h3><p>The address in front of the app looks for the label <code>frontend</code>, but the app is labelled <code>web</code>. Nobody receives the traffic.</p></div></li>
        <li><span class="t">4 s</span><div><h3>It proposes the fix and asks</h3><p>“Point it back to <code>web</code>, the label it had before.” Changing traffic needs a human, so it waits.</p></div></li>
        <li><span class="t">76 s</span><div><h3>A human approves</h3><p>The fix is tested with a dry-run, applied, and checked.</p></div></li>
        <li class="end"><span class="t">77 s</span><div><h3>Healthy again</h3><p>Every check passes. Nabd's own work took about five seconds; the rest was waiting for the human.</p></div></li>
      </ol>
      <p class="after"><a href={`${repo}/blob/main/reports/20261030-190908-service-web.md`}>Read the full incident report</a></p>
    </section>

    <section id="how" class="how wrap" aria-labelledby="how-h">
      <div class="head">
        <h2 id="how-h">How Nabd works</h2>
        <p>The same five steps every time. Step four is where safety decides, not the AI.</p>
      </div>
      <ol>
        <li><span class="n">1</span><h3>Notice</h3><p>An independent health check sees the app failing.</p></li>
        <li><span class="n">2</span><h3>Investigate</h3><p>It reads what Kubernetes knows: errors, logs, events, settings. Never password values.</p></li>
        <li><span class="n">3</span><h3>Diagnose</h3><p>Proven rules first. An AI model (Claude) only for problems the rules don't recognise.</p></li>
        <li class="gate"><span class="n">4</span><h3>Safety checks</h3><p>Is the fix on the list? Does it need a human? Does a dry-run accept it? Does the evidence support it?</p></li>
        <li><span class="n">5</span><h3>Fix and verify</h3><p>Apply, re-check, and undo if it didn't work. Or hand over to a human.</p></li>
      </ol>
    </section>

    <section id="results" class="results wrap" aria-labelledby="results-h">
      <div class="head">
        <h2 id="results-h">Does it actually work?</h2>
        <p>
          We broke our test system in 14 different ways and let Nabd handle each one alone. Five of them were kept secret while
          building it, to prove it handles problems it was never designed for.
        </p>
      </div>
      {done ? (
        <>
          <p class="verdict-line">
            Nabd handled <b>{hybrid.ok} of {hybrid.n}</b>, made <b>{hybrid.unsafe} unsafe changes</b>, and needed the AI model only <b>{hybrid.calls} times</b>.
          </p>
          <div class="table-wrap">
            <table>
              <thead>
                <tr><th scope="col">Version</th><th scope="col">All 14 faults</th><th scope="col">The 5 secret ones</th><th scope="col">Unsafe changes</th><th scope="col">AI calls</th></tr>
              </thead>
              <tbody>
                {modes.map((m) => {
                  const t = total(m);
                  const h = held(m);
                  return (
                    <tr class={m === "hybrid" ? "best" : ""}>
                      <th scope="row">{modeName[m]}</th>
                      <td>{t.ok} / {t.n}</td>
                      <td>{h ? `${h.ok} / ${h.total}` : "–"}</td>
                      <td>{t.unsafe}</td>
                      <td>{t.calls}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
          <ul class="reading">
            <li><b>Rules alone</b> are fast and reliable on problems they know, but missed one of the secret faults.</li>
            <li><b>The AI model alone</b> handled every secret fault, but stumbled twice on ordinary ones: it fixed a setting and forgot to restart the app, and once it was too cautious to act.</li>
            <li><b>Nabd combines them:</b> rules first, the AI only when the rules have no answer. It handled all 14, and never made an unsafe change.</li>
          </ul>
          <details>
            <summary>Every fault, in plain words</summary>
            <div class="table-wrap">
              <table class="per-fault">
                <thead><tr><th scope="col">What broke</th><th scope="col">Right answer</th>{modes.map((m) => <th scope="col">{modeName[m]}</th>)}</tr></thead>
                <tbody>
                  {faults.map((f) => (
                    <tr>
                      <th scope="row">{plain[f.fault] ?? f.fault}{f.split === "heldout" && <span class="secret">secret</span>}</th>
                      <td>{f.expected === "fix" ? "Fix it" : "Hand to a human"}</td>
                      {modes.map((m) => {
                        const r = f.modes[m];
                        return <td class={r ? (r.ok ? "pass" : "miss") : ""}>{cell(r)}</td>;
                      })}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>
          <p class="fine">“Handled” means fixed and confirmed by the health check, or correctly handed to a human without changing anything. Raw data: <a href={`${repo}/tree/main/results`}>results/</a>.</p>
        </>
      ) : (
        <p class="fine">The benchmark is running. Results appear here when it finishes.</p>
      )}
    </section>

    <section class="glossary wrap" aria-labelledby="glossary-h">
      <h2 id="glossary-h">Words you might not know</h2>
      <dl>
        {glossary.map(([t, d]) => (
          <div><dt>{t}</dt><dd>{d}</dd></div>
        ))}
      </dl>
    </section>

    <section class="limits wrap" aria-labelledby="limits-h">
      <h2 id="limits-h">Honest limits</h2>
      <ul>
        <li>Tested on a small test system (three servers, three apps), not yet in a real company.</li>
        <li>The browser demo is a simulation that runs Nabd's rules. The AI part runs from the command line with an API key.</li>
        <li>Some faults take about a minute and a half to show up, because Kubernetes has to fail its health checks first.</li>
      </ul>
    </section>

    <section class="close wrap">
      <h2>Break it yourself.</h2>
      <p>Pick a fault, look around like an engineer, and watch Nabd treat it. Nothing to install.</p>
      <a class="btn" href={`${base}/demo/`}>Try it in your browser</a>
    </section>
  </main>
</Base>

<script>
  import { baseline, inject } from "../lib/sim";
  import { run } from "../lib/nabd";
  import { Rx } from "../lib/label";

  const rx = new Rx(document.getElementById("hero-rx")!);
  const chips = [...document.querySelectorAll<HTMLButtonElement>(".chip[data-fault]")];
  let busy = false;

  async function treat(id: string) {
    if (busy) return;
    busy = true;
    chips.forEach((c) => { c.setAttribute("aria-pressed", String(c.dataset.fault === id)); c.disabled = true; });
    const c = baseline();
    inject(c, id);
    rx.begin();
    await run(c, { onStep: (s) => rx.step(s), approve: () => rx.ask() });
    chips.forEach((c) => (c.disabled = false));
    busy = false;
  }
  chips.forEach((chip) => chip.addEventListener("click", () => treat(chip.dataset.fault!)));
  setTimeout(() => treat("dev-01-image-typo"), 500);
</script>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: start; padding-block: clamp(2rem, 5vw, 4.5rem) 2rem; }
  .pitch { padding-top: clamp(0rem, 2vw, 1.5rem); }
  .pitch h1 { font-size: clamp(2.4rem, 1.4rem + 3.6vw, 4.4rem); }
  .lede { margin-top: 1.4rem; font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem); max-width: 34em; color: var(--ink-2); }
  .lede .ar { color: var(--green-deep); }
  .ctas { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2rem; }
  .tryline { display: flex; flex-wrap: wrap; align-items: center; gap: 0.7rem; margin-bottom: 1rem; }
  .tryline > span { font-weight: 700; font-size: 0.95rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.45rem; }
  .note { margin-top: 0.9rem; font-size: 0.88rem; color: var(--ink-2); }

  .head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 1rem 3rem; align-items: end; margin-bottom: 2.2rem; }
  .head p { color: var(--ink-2); max-width: 36em; }
  section.wrap + section.wrap { margin-top: clamp(4.5rem, 9vw, 7rem); }

  .problem h2 { max-width: 20em; }
  .story { list-style: none; padding: 0; margin: 2.2rem 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; border-top: 2px solid var(--ink); counter-reset: s; }
  .story li { padding: 1.4rem 1.6rem 1.6rem 0; counter-increment: s; }
  .story li + li { padding-left: 1.6rem; border-left: 1px solid var(--rule); }
  .story h3::before { content: counter(s) ". "; color: var(--green-deep); }
  .story p { margin-top: 0.5rem; color: var(--ink-2); }
  .why { margin-top: 2rem; background: var(--paper); border-radius: 18px; padding: clamp(1.4rem, 3.5vw, 2.2rem); box-shadow: var(--shadow); max-width: 52rem; }
  .why p { margin-top: 0.6rem; color: var(--ink-2); font-size: 1.08rem; }
  .why strong { color: var(--ink); }

  .rules3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .rules3 > div { background: var(--paper); border-radius: 16px; padding: 1.3rem 1.4rem; box-shadow: var(--shadow); }
  .rules3 h3 { display: flex; align-items: center; gap: 0.55rem; margin-bottom: 0.8rem; }
  .rules3 ul { margin: 0; padding-left: 1.1rem; display: grid; gap: 0.5rem; color: var(--ink-2); }
  .dot { width: 0.8rem; height: 0.8rem; border-radius: 50%; display: inline-block; flex: none; }
  .dot.ok { background: var(--green); }
  .dot.warn { background: #e3a21b; }
  .dot.no { background: var(--bad); }
  .after { margin-top: 1.4rem; color: var(--ink-2); max-width: 48em; }

  .case { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; max-width: 56rem; }
  .case li { display: grid; grid-template-columns: 4.5rem 1fr; gap: 1.2rem; align-items: start; background: var(--paper); border-radius: 14px; padding: 1rem 1.2rem; box-shadow: var(--shadow); }
  .case .t { font: 600 0.9rem/1.6 var(--mono); color: var(--green-deep); }
  .case p { margin-top: 0.3rem; color: var(--ink-2); }
  .case li.end { background: var(--green-light); box-shadow: none; }

  .how ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); border-top: 2px solid var(--ink); }
  .how li { padding: 1.3rem 1.2rem 1.5rem; border-right: 1px solid var(--rule); }
  .how li:first-child { padding-left: 0; }
  .how li:last-child { border-right: 0; }
  .how .n { font: 600 0.8rem/1 var(--mono); color: var(--ink-2); }
  .how h3 { margin: 0.6rem 0 0.45rem; }
  .how p { font-size: 0.95rem; color: var(--ink-2); }
  .how li.gate { background: var(--paper); padding-left: 1.2rem; }
  .how li.gate .n { color: var(--green-deep); }

  .verdict-line { font-size: clamp(1.2rem, 1rem + 0.8vw, 1.6rem); max-width: 34em; margin-bottom: 1.6rem; line-height: 1.4; }
  .verdict-line b { color: var(--green-deep); }
  .table-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 0.98rem; }
  th, td { text-align: left; padding: 0.85rem 1rem 0.85rem 0; border-bottom: 1px solid var(--rule); }
  thead th { font: 600 0.72rem/1.2 var(--mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-2); border-bottom: 2px solid var(--ink); white-space: nowrap; }
  tbody th { font-weight: 720; }
  tr.best th, tr.best td { color: var(--green-deep); font-weight: 760; }
  td.pass { color: var(--green-deep); }
  td.miss { color: var(--warn); font-weight: 700; }
  .secret { margin-left: 0.5rem; font: 600 0.66rem/1 var(--mono); text-transform: uppercase; letter-spacing: 0.08em; padding: 0.2rem 0.4rem; border-radius: 5px; background: var(--ground-deep); color: var(--green-deep); vertical-align: 0.15em; }
  .reading { margin: 1.8rem 0 0; padding-left: 1.1rem; display: grid; gap: 0.6rem; max-width: 52em; color: var(--ink-2); }
  .reading b { color: var(--ink); }
  details { margin-top: 1.6rem; }
  summary { cursor: pointer; font-weight: 700; }
  .per-fault { margin-top: 1rem; font-size: 0.92rem; }
  .fine { margin-top: 1.2rem; color: var(--ink-2); font-size: 0.9rem; }

  .glossary dl { margin: 1.6rem 0 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.2rem 2.6rem; }
  .glossary dt { font-weight: 760; }
  .glossary dd { margin: 0.25rem 0 0; color: var(--ink-2); }

  .limits ul { margin: 1.2rem 0 0; padding-left: 1.1rem; display: grid; gap: 0.6rem; color: var(--ink-2); max-width: 52em; }

  .close { text-align: center; display: grid; justify-items: center; gap: 1rem; padding: clamp(2.5rem, 6vw, 4.5rem) 1rem; background: var(--green-light); border-radius: 22px; }
  .close p { color: var(--ink-2); max-width: 32em; margin-bottom: 0.6rem; }

  @media (max-width: 960px) {
    .hero, .head { grid-template-columns: 1fr; }
    .story, .rules3 { grid-template-columns: 1fr; }
    .story li, .story li + li { padding: 1.2rem 0; border-left: 0; border-bottom: 1px solid var(--rule); }
    .how ol { grid-template-columns: 1fr; }
    .how li, .how li:first-child { padding: 1.1rem 0; border-right: 0; border-bottom: 1px solid var(--rule); }
    .how li.gate { padding-left: 1rem; }
  }
  @media (max-width: 640px) {
    .glossary dl { grid-template-columns: 1fr; }
    .case li { grid-template-columns: 3.4rem 1fr; gap: 0.8rem; }
  }
</style>
