---
interface Props { id: string }
const { id } = Astro.props;
---
<article class="rx" id={id} aria-live="polite" aria-label="What Nabd did">
  <header class="rx-head"><span>What Nabd did</span><span class="rx-status" data-rx-status data-tone="idle">Waiting</span></header>
  <div class="rx-body"><p class="rx-empty">Nothing is broken yet. Pick a problem to start.</p></div>
  <div class="rx-foot"><div class="rx-sign" data-state="idle" hidden></div></div>
</article>
